{
  "manifest_version": 3,
  "name": "WordWise Extension",
  "version": "1.0",
  "description": "Smart English vocabulary assistant",
  "permissions": ["contextMenus", "scripting", "activeTab", "storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["modal.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
