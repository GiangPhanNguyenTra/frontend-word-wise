{
  "manifest_version": 3,
  "name": "WordWise Extension",
  "version": "1.1",
  "description": "Smart English vocabulary assistant",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "storage",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://core-word-wise.onrender.com/*",
    "https://overluxuriously-kinematographical-annemarie.ngrok-free.dev/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://fe-word-wise.onrender.com/*",
      "http://localhost:3000/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["modal.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
